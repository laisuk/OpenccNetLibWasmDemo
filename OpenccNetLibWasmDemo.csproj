<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly"
                          Version="10.0.11"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
                          Version="10.0.11"
                          PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          Reference the local OpenccNetLib build directly so CI and the WASM demo
          use the exact library binary committed with this repository.
        -->
        <Reference Include="OpenccNetLib">
            <HintPath>lib/OpenccNetLib.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="ZstdSharp">
          <HintPath>lib\ZstdSharp.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <Content Include=".github\workflows\build_deploy.yml" />
    </ItemGroup>

</Project>
